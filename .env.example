# 이 파일을 .env로 복사한 뒤 값을 채우세요. (.env는 git에 올라가지 않습니다)
#   cp .env.example .env
# EXPO_PUBLIC_ 접두 변수만 앱 코드에서 읽히며, Expo가 빌드 시 번들에 자동 인라인합니다.
# 값을 바꾼 뒤에는 반드시 `npx expo start -c`로 캐시를 지우고 재시작하세요.

# ── 필수 ─────────────────────────────────────────────
# 배포된 백엔드 주소. 비밀값이 아니므로 그대로 쓰면 됩니다.
# (로컬 서버를 직접 띄워 붙으려면 http://<맥 LAN IP>:3001 로 바꾸세요)
EXPO_PUBLIC_SERVER_URL=https://gyeoldaero-server.onrender.com

# AI 기능(자동 설정·동선 설계·명소 추천)에 필요합니다.
# 서버의 PLANNER_TOKEN과 같은 값이어야 하며, 팀 내부에서 공유받으세요.
# 비워두면 AI만 막히고(401) 나머지는 정상 동작합니다.
EXPO_PUBLIC_PLANNER_API_TOKEN=

# ── 선택 ─────────────────────────────────────────────
# 네이버 클라우드 플랫폼 → Maps → Application 등록.
# 없으면 동선 지도가 직선으로 표시되고, 숙소 직접입력(주소 검색)이 동작하지 않습니다.
EXPO_PUBLIC_NAVER_MAP_API_KEY_ID=
EXPO_PUBLIC_NAVER_MAP_API_KEY=

# data.go.kr → 한국관광공사 TourAPI. 현재 미사용(2차 폴백 용도)이라 비워도 됩니다.
EXPO_PUBLIC_TOUR_API_KEY=

# 날씨는 키가 필요 없는 Open-Meteo를 쓰므로 설정할 값이 없습니다.

# 이 파일을 .env.local로 복사해서 쓰세요 (.env.local은 커밋되지 않습니다).
# AI 동선 서버(server/) 주소. 휴대폰 Expo Go에서는 PC의 LAN IP를 적어야 합니다 (예: http://192.168.0.12:8787).
# 비워두면 AI 없이 기존 알고리즘으로만 일정을 만듭니다.
EXPO_PUBLIC_PLANNER_API_URL=

# 선택: 서버(server/.env)에 PLANNER_TOKEN을 설정했다면 같은 값을 넣으세요.
# 앱 번들에서 볼 수 있는 값이라 비밀번호가 아니라, 주소만 알고 호출하는 것을 막는 용도입니다
EXPO_PUBLIC_PLANNER_API_TOKEN=

# 이 파일을 .env로 복사한 뒤 실제 값을 채우세요. (.env는 git에 올라가지 않습니다)
# EXPO_PUBLIC_ 접두 변수만 앱 코드에서 읽히며, Expo가 빌드 시 클라이언트 번들에 자동 인라인합니다.

# 결대로 백엔드(gyeoldaero-server) 주소.
# 실기기(Expo Go)에서는 localhost가 폰 자신을 가리키므로 Mac의 LAN IP를 쓰세요.
# Mac에서 확인: ipconfig getifaddr en0
EXPO_PUBLIC_SERVER_URL=http://192.168.0.0:3001

# data.go.kr → 한국관광공사 TourAPI 활용신청 → 일반 인증키(Decoding)
EXPO_PUBLIC_TOUR_API_KEY=여기에_TourAPI_키
# data.go.kr → 기상청 단기예보 활용신청. 비워두면 날씨는 mock(맑음)으로 동작합니다.
EXPO_PUBLIC_WEATHER_API_KEY=여기에_기상청_키

# 네이버 클라우드 플랫폼 → Maps → Application 등록
EXPO_PUBLIC_NAVER_MAP_API_KEY_ID=여기에_키_ID
EXPO_PUBLIC_NAVER_MAP_API_KEY=여기에_키

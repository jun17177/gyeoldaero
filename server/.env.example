# 이 파일을 .env로 복사한 뒤 값을 채우세요. .env는 절대 커밋하지 않습니다.
ANTHROPIC_API_KEY=
# 워크스페이스에 묶이지 않은 조직 단위 키를 쓸 때만 필요 (Console에서 확인한 워크스페이스 ID)
ANTHROPIC_WORKSPACE_ID=
PORT=8787

# 선택: 모델과 추론 강도(effort). 비워두면 claude-sonnet-5 / low
# 동선 품질이 아쉬우면 PLANNER_EFFORT=medium으로 올려 응답 시간과 비교해보세요 (서버 로그에 시도별 ms·토큰이 찍힘)
PLANNER_MODEL=
PLANNER_EFFORT=
# 선택: adaptive로 두면 추론을 켜서 동선 품질이 좋아지지만 느려짐 (명소 9곳 기준 켬 17~25초, 끔 8~14초). 비워두면 끔
PLANNER_THINKING=

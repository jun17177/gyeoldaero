# 이 파일을 .env로 복사한 뒤 실제 키를 넣으세요. (.env는 git에 올라가지 않습니다)

# 사용할 LLM: claude | gemini
LLM_PROVIDER=claude

# Anthropic (console.anthropic.com에서 발급)
ANTHROPIC_API_KEY=
# 동선 설계(route-plan, trip-settings) — effort를 쓰므로 effort 지원 모델만 가능
PLANNER_MODEL=claude-sonnet-5
# 명소 추천·코멘트 등 가벼운 작업 — 속도 우선
AI_MODEL=claude-haiku-4-5

PLANNER_EFFORT=low
PLANNER_THINKING=disabled
PLANNER_TOKEN=

# Google Gemini (aistudio.google.com에서 발급) — LLM_PROVIDER=gemini일 때만 필요
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

PORT=3001
VISITJEJU_API_KEY=
